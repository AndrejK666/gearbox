{{ header }}

mod registered_gears;
{%- if render_env %}
mod config_env;
{%- endif %}

use std::path::PathBuf;

use anyhow::Result;
use clap::Parser;
use toolkit::bootstrap::oop::{OopRunOptions, run_oop_with_options};
{%- if render_env %}
use toolkit::bootstrap::AppConfig;
{%- endif %}
use toolkit::registry::GearRegistry;

/// The out-of-process worker for `{{ application }}`.
#[derive(Parser)]
#[command(name = "{{ bin_name }}")]
#[command(about = "Generated Gears worker: {{ gear_count }} gear(s) composed by gearbox")]
struct Cli {
    /// Path to the configuration file.
    ///
    /// The host passes this through `execution.args`, and it is the only
    /// channel that works: the runtime also reads `TOOLKIT_CONFIG_PATH`, but
    /// nothing sets it.
    #[arg(short, long)]
    config: Option<PathBuf>,

    /// Log verbosity level (-v debug, -vv trace).
    #[arg(short, long, action = clap::ArgAction::Count)]
    verbose: u8,

    /// Which of the gear's declared roles this process runs as.
    ///
    /// A role is a directory registration name, and one gear is one binary
    /// whichever role it runs in -- so this is an input at startup rather than
    /// a property of the build. Omitted, the process runs as the role this
    /// deployment was generated for.
    #[arg(long)]
    role: Option<String>,

    /// List the gears actually linked into this binary and exit.
    ///
    /// The same oracle the host carries, and a worker needs it more: placement
    /// is a link-time decision, so "which gears are in this binary" is the
    /// question that says whether the split happened at all.
    #[arg(long)]
    list_registered_gears: bool,
}

/// Every role the anchor gear declares, and the name each registers under.
///
/// Compiled in so a role this gear does not declare is refused rather than
/// registered: a typo would otherwise put the process in the directory under a
/// name nothing ever looks up, and nothing would say so.
const ROLES: &[(&str, &str)] = &[
{%- for role in roles %}
    ("{{ role.name }}", "{{ role.directory_name }}"),
{%- endfor %}
];

/// What this deployment registers under when `--role` is not given.
const DEFAULT_GEAR_NAME: &str = "{{ gear_name }}";

/// The `gears.<key>` section this process reads its configuration from.
///
/// The anchor gear's own id, and not the name above. Those are the same string
/// for a gear that runs in one shape, and they are not for a role: an instance
/// registers as its role's directory name while the gear still reads
/// `gears.<gear-id>.config`, because that is the key `GearCtx::config()` uses
/// and it comes from the `#[toolkit::gear(name = ...)]` attribute.
const CONFIG_GEAR_NAME: &str = "{{ config_gear_name }}";

/// Resolve the directory name this process registers under.
fn directory_name(requested: Option<&str>) -> Result<String> {
    let Some(role) = requested else {
        return Ok(DEFAULT_GEAR_NAME.to_owned());
    };
    if let Some((_, name)) = ROLES.iter().find(|(declared, _)| *declared == role) {
        return Ok((*name).to_owned());
    }
    let declared: Vec<&str> = ROLES.iter().map(|(name, _)| *name).collect();
    anyhow::bail!(
        "--role {role} is not a role this gear declares{}",
        if declared.is_empty() {
            "; it declares none".to_owned()
        } else {
            format!("; it declares {}", declared.join(", "))
        }
    )
}

/// Print the registry's own inventory, in the order it resolved.
///
/// The order is *a* topological order, not a canonical one: the registry seeds
/// Kahn's algorithm from a `HashMap`, so two runs can legitimately disagree
/// about gears that do not depend on one another. Compare sorted output.
fn list_registered_gears() -> Result<()> {
    let registry = GearRegistry::discover_and_build()?;
    for entry in registry.gears() {
        let mut deps: Vec<&str> = entry.deps().to_vec();
        deps.sort_unstable();
        println!("{}\t{}", entry.name(), deps.join(","));
    }
    Ok(())
}

{% if render_env -%}
fn main() -> Result<()> {
    let cli = Cli::parse();

    // Before anything reads configuration, as in the host: the oracle has to be
    // answerable for a binary whose configuration is the thing under suspicion.
    if cli.list_registered_gears {
        return list_registered_gears();
    }

    // The gears' configuration reads variables the deployment sets
    // (`${OIDC_ISSUER}`), and the runtime loads the file itself. So the
    // substituted gear sections are written under the home directory and
    // handed to it as its gears directory, before the runtime starts.
    if let Some(path) = cli.config.as_ref() {
        let config = AppConfig::load_or_default(Some(path))?;
        let mut gears = config.gears;
        if config_env::render_gears(&mut gears, Some(path)).map_err(anyhow::Error::msg)? {
            let dir = config.server.home_dir.join(".gearbox-rendered-gears");
            config_env::write_gears_dir(&dir, &gears).map_err(anyhow::Error::msg)?;
            // SAFETY: no other thread exists yet -- the runtime is built below --
            // so nothing can read the environment while it is written.
            unsafe { std::env::set_var("APP__GEARS_DIR", &dir) };
        }
    }

    tokio::runtime::Builder::new_multi_thread()
        .enable_all()
        .build()?
        .block_on(run(cli))
}

/// The worker, on the runtime `main` built.
async fn run(cli: Cli) -> Result<()> {
{% else -%}
#[tokio::main]
async fn main() -> Result<()> {
    let cli = Cli::parse();

    // Before anything reads configuration, as in the host: the oracle has to be
    // answerable for a binary whose configuration is the thing under suspicion.
    if cli.list_registered_gears {
        return list_registered_gears();
    }

{% endif %}    // `..Default::default()` is load-bearing, not tidiness. It is where
    // `TOOLKIT_DIRECTORY_ENDPOINT` is read, and the host sets that variable when
    // it spawns this process -- so listing every field explicitly would silently
    // lose the directory and leave every remote binding unresolvable.
    let options = OopRunOptions {
        // The directory identity. The runtime takes this field as given, so the
        // name is decided here -- from `--role` when a role is asked for, and
        // otherwise from what this deployment was generated for.
        gear_name: directory_name(cli.role.as_deref())?,
        // And the configuration identity, which is a different one. Left to
        // default it follows `gear_name`, which is wrong the moment a role makes
        // the two differ: the host's rendered config would be filed under the
        // role's name and the gear would read its own, so the override would
        // silently not arrive.
        config_gear_name: Some(CONFIG_GEAR_NAME.to_owned()),
        verbose: cli.verbose,
        config_path: cli.config,
        version: Some("{{ version }}".to_owned()),
        ..Default::default()
    };

    run_oop_with_options(options).await
}
