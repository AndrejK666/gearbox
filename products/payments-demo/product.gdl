# The Payments Demo product.
#
# All three deployment profiles are declared as DATA and selected at resolve
# time (`gearbox resolve --profile <id>`). There is no `if` anywhere -- GDL has
# none by design -- so profile-scoping is a `profiles = [...]` list field on
# `bind`, `cluster_profile` and `application`. A description that could branch on
# the profile would be a program whose output depends on how it was invoked.

product(
    id = "payments-demo",
    name = "Payments Demo",
    version = "0.1.0",

    sources = [source(id = "gears-rust", at = path("../../../gears-rust"))],

    profiles = [
        embedded(id = "dev", database = postgres(
            host = "127.0.0.1", user = "postgres", password = "${GEARS_PG_PASSWORD}",
            params = {"sslmode": "disable"},
        )),
        self_hosted(
            id = "local",
            host = "gateway",
            worker_discovery = "directory",
            database = postgres(host = "127.0.0.1", user = "postgres",
                password = "${GEARS_PG_PASSWORD}", params = {"sslmode": "disable"}),
            target_dir = "../../../gears-rust/target",
        ),
        kubernetes(
            id = "prod",
            discovery = "static",
            namespace = "payments",
            database = postgres(host = "postgres.example.com", user = "payments",
                password = "${GEARS_PG_PASSWORD}", existing_secret = "payments-db"),
            image_registry = "registry.example.com/payments",
        ),
    ],
    default_profile = "dev",

    # Note what is NOT listed: grpc-hub, authn-resolver, types-registry and
    # cluster. They arrive through the colocated_deps closure, which is a
    # link-time fact the resolver may never sever.
    gears = [
        use_gear("api-gateway", source = "gears-rust"),
        use_gear("service-discovery", source = "gears-rust"),
        use_gear("api-contracts", source = "gears-rust"),
        use_gear("api-contracts-consumer", source = "gears-rust"),

        # Selected explicitly, because nothing pulls it: the closure comment
        # above is true of grpc-hub, authn-resolver and types-registry, but
        # `cluster` arrives only through `deps = [cluster]`, and the one gear in
        # the corpus that declares that edge has no description. Without it in
        # the closure the provider registry is empty and every cluster
        # requirement resolves to GBX0505 -- the providers are projected from
        # `ClusterGear::provider_registry()`, so the gear has to be present for
        # them to exist at all.
        use_gear("cluster", source = "gears-rust"),

        # authn-resolver routes to whichever plugin implements its extension
        # point. The choice is per profile, which is the whole reason `plugins`
        # takes `profiles`: dev accepts any token, prod validates against a real
        # issuer, and that is one product file rather than two.
        #
        # `vendor` is a join key: the host queries types-registry for plugin
        # instances matching ITS vendor and takes the lowest priority. Both sides
        # default to "constructorfabric", so leaving both alone is correct --
        # overriding one side and not the other is what fails silently at
        # runtime, and is what GBX0512 refuses.
        use_gear("authn-resolver", source = "gears-rust",
            plugins = [
                # `local` takes the static plugin for the same reason `dev`
                # does: it is a one-machine development profile, and validating
                # tokens against a real issuer there is a decision nobody wants.
                # Moving it here was not cosmetic -- the host refused to start
                # with `missing field jwt`, because `OidcAuthNGearConfig.jwt` has
                # no default and `oidc-authn-plugin` does not expose it, so no
                # description can supply it. Found by running the product.
                plugin("static-authn-plugin", profiles = ["dev", "local"],
                       config = {"mode": "accept_all"}),
                plugin("oidc-authn-plugin", profiles = ["prod"],
                       config = {"issuer": "https://id.example.com"}),
            ],
        ),
    ],

    bindings = [
        bind(
            consumer = "api-contracts-consumer",
            contract = "api-contracts/PaymentApi@v1",
            mode = binding_mode.remote,
            transport = transport.rest,
            profiles = ["local", "prod"],
        ),
    ],

    # `name` is the operator side of the join key a gear declares as
    # `impl ClusterProfile { const NAME }`. `provider("...")` REFERENCES a
    # provider the catalogue projected from Rust; it does not describe one.
    #
    # dev binds the standalone backend, which is process-local: every replica
    # would get its own in-memory store and coordinate none of the others. That
    # is correct for one process and wrong for any other, which is what the
    # resolver reports as GBX0503 rather than letting it fail silently at run
    # time.
    cluster_profiles = [
        cluster_profile(
            name = "event-broker",
            cache = provider("standalone"),
            profiles = ["dev"],
        ),
        cluster_profile(
            name = "event-broker",
            profiles = ["local", "prod"],
            cache = provider(
                "postgres",
                # The reference, not the credential. The reference itself is a
                # resolved fact and does reach the lock; what never reaches it,
                # or any values file, is the secret the reference points at.
                # Without this the resolver refuses the provider outright
                # (GBX0506), because a backend that needs credentials and is
                # told nowhere to find them is a product that starts and then
                # cannot connect.
                secret_ref = "env:PG_PASSWORD",
                connection_string = "postgres://payments@${PG_HOST}:5432/payments?password=${PG_PASSWORD}",
                schema = "cluster",
                pool_max_size = 10,
            ),
        ),
    ],

    applications = [
        application("audit", anchor = "api-contracts-consumer", replicas = 2, profiles = ["prod"]),
    ],

    preferences = [prefer.existing_infrastructure(), prefer.fewer_applications()],
)
